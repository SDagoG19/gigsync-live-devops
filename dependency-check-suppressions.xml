<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check - Supresiones de falsos positivos para GigSync Live.

  Política del equipo:
    * Solo se suprime un hallazgo cuando se demuestra que es un FALSO POSITIVO
      (la CPE no corresponde al paquete, o la vulnerabilidad no aplica a la versión usada).
    * Cada supresión debe tener: justificación en <notes>, responsable y fecha de revisión
      (until="AAAA-MM-DDZ") para que expire y se vuelva a evaluar.
    * Las vulnerabilidades reales con CVSS >= 7 NO se suprimen: se corrigen actualizando la dependencia.

  Ejemplo:
  <suppress until="2027-06-30Z">
    <notes>Falso positivo: la CPE apunta a otro producto con el mismo nombre. Revisó: Franco Moncayo.</notes>
    <packageUrl regex="true">^pkg:npm/nombre\-del\-paquete@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
