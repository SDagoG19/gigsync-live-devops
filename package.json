{
  "name": "gigsync-live-devops",
  "version": "1.0.0",
  "description": "GigSync Live Core Service - Taller 4 Arquitectura de Software II ITM",
  "main": "src/bookingService.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit"
  },
  "keywords": [
    "gigsync",
    "devops",
    "azure-pipelines",
    "sonar",
    "owasp",
    "jest"
  ],
  "author": "Luisa Puentes, Sebastian Davila, Franco Moncayo",
  "license": "ISC",
  "dependencies": {
    "kafkajs": "^2.2.4",
    "mysql2": "^3.9.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
