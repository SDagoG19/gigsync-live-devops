{
  "name": "gigsync-live-devops",
  "version": "1.0.0",
  "description": "GigSync Live Core Service - Guía 5 CI/CD seguro (Azure DevOps + GitHub Actions) - Arquitectura de Software II ITM",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "gigsync",
    "devops",
    "azure-pipelines",
    "github-actions",
    "azure-app-service",
    "owasp-dependency-check",
    "gitleaks",
    "jest"
  ],
  "author": "Luisa Puentes, Sebastian Davila, Franco Moncayo",
  "license": "ISC",
  "dependencies": {
    "kafkajs": "^2.2.4",
    "mysql2": "^3.9.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0"
  },
  "jest-junit": {
    "outputDirectory": "junit",
    "outputName": "junit.xml"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
